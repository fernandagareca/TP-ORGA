    52                                  
    53                                  ; Calcular posicion del vector en base a posicion matriz: 
    54                                  ; props: 
    55                                  ; %1: fil -> x
    56                                  ; %2: col -> y
    57                                  ; %3: cantidad_columnas -> length
    58                                  
    59                                  %macro obtener_posicion_vector_matriz 3
    60                                          movzx   rax,    BYTE [%1]               ; rax = fila (ampliar a 64 bits para cálculos)
    61                                          movzx   rbx,    BYTE [%2]               ; rbx = columna (ampliar a 64 bits)
    62                                          
    63                                          imul    rax,    %3                      ; (fila) * CANT_COL
    64                                          add     rax,    rbx                     ; (fila) * CANT_COL + (columna) = pos
    65                                  %endmacro
    66                                  
    67                                  ; Props
    68                                  ; al: elemento a buscar
    69                                  ; %1: vector
    70                                  ; %2: longitud
    71                                  ; -----------------------------------------------------------
    72                                  %macro vector_incluye 2
    73                                  
    74                                          mov     rcx,    0
    75                                  %%iterar_vector:
    76                                          movzx   rbx,     BYTE [%1+rcx]                    ; [0+rcx] siendo rcx < 16
    77                                          cmp     al,      bl                               ; si la poscion adyancente es una posicion invalida
    78                                          je      %%encontrado                              ; evaluo la siguiente 
    79                                          
    80                                          inc     rcx
    81                                          cmp     rcx,    %2
    82                                          jl      %%iterar_vector             ; repito el loop hasta terminar de iterar sobre invalidas[]
    83                                        
    84                                          mov     al, 1
    85                                          jmp     %%fin
    86                                  
    87                                  %%encontrado:
    88                                          mov     al, 0
    89                                          jmp     %%fin
    90                                  %%fin:
    91                                  %endmacro       
