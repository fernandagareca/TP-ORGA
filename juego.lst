   233                                  
   234                                  ; Verifica si la posicion es valida, devuelve al = 0 si es valida, si no al = 1
   235                                  ; -----------------------------------------------------------
   236                                  verificar_pos_valida:
   237                                  %macro verificar_posicion_valida 0
   238                                          ; mov al, BYTE %1 ; al es la posicion a evaluar
   239                                            
   240                                          cmp     al, 48
   241                                          jg      %%es_invalida            ; si la posicion adyacente es mayor a 48, evaluo la siguiente
   242                                          
   243                                          cmp     al, 0
   244                                          jl      %%es_invalida            ; si la posicion adyacente es menor a 0, evaluo la siguiente
   245                                          
   246                                          mov    al, 0
   247                                          jmp    %%fin
   248                                  
   249                                  %%es_invalida:
   250                                          mov     al, 1
   251                                  %%fin:
   252                                  %endmacro
   253                                  ; -----------------------------------------------------------
   254                                  
   255                                  
   256                                  ; Imprime las opciones de movimiento validas para el oficial 
   257                                  ; Props: 
   258                                  ;       %1: fil
   259                                  ;       %2: col 
   260                                  ; -----------------------------------------------------------
   261                                  imprimir_pos_oficial:
   262                                  %macro obtener_pos_validas_oficial 2
   263                                          mov BYTE [longitud_posiciones_mov], 0
   264                                          mov BYTE [posiciones_mov], 0
   265                                  
   266                                          mov BYTE [i], -1   
   267                                          mov al, BYTE [%1]
   268                                          mov [x], al
   269                                          mov al, BYTE [%2]
   270                                          mov [y], al
   271                                  
   272                                          obtener_posicion_vector_matriz       x,y,CANT_COL 
   273                                          mov r12b, al
   274                                  %%filas:
   275                                          mov BYTE [j], -1             ; voy a la primera columna aux
   276                                          mov al, BYTE [%1]
   277                                          add al, [i]
   278                                          mov [x], al
   279                                  
   280                                  %%columnas:
   281                                          mov al, BYTE [%2]
   282                                          add al, [j]
   283                                          mov [y], al
   284                                  
   285                                          obtener_posicion_vector_matriz       x,y,CANT_COL ; rax = posicion adyancente del vector
   286                                  
   287                                          ; si la poscion adyancente es la posicion inicial es invalida
   288                                          cmp     al,    r12b
   289                                          je      %%siguiente_posicion_adyacente   
   290                                  
   291                                          mov dl, al
   292                                          ; si la poscion adyancente es una posicion invalida
   293                                          verificar_posicion_valida
   294                                          cmp     al, 1
   295                                          je      %%siguiente_posicion_adyacente   
   296                                          mov al, dl
   297                                  
   298                                  %%es_pos_valida:
   299                                          mov dl, BYTE [matriz+rax]                       ; asigno a dl, el caracter de la matriz
   300                                          cmp dl, [pos_invalida]                          ; Si en la posicion es una invalida no es valida
   301                                          je %%siguiente_posicion_adyacente
   302                                  
   303                                          cmp dl, [oficial]                               ; Si en la posicion es un oficial no es valida
   304                                          je %%siguiente_posicion_adyacente
   305                                        
   306                                          cmp dl, [soldado]                               ; Si en la posicion es un oficial no es valida
   307                                          je %%es_soldado
   308                                  
   309                                  %%mostrar_vacio: 
   310                                          mov bl, al
   311                                          print_opcione_moviento  opcion_vacia, longitud_posiciones_mov, x, y
   312                                          mov al, bl
   313                                          jmp     %%añadir_movimiento
   314                                  
   315                                  %%añadir_movimiento:
   316                                          movzx     rdi, BYTE [longitud_posiciones_mov]
   317                                          mov     BYTE [posiciones_mov + rdi], al
   318                                          inc     BYTE [longitud_posiciones_mov]
   319                                          jmp     %%siguiente_posicion_adyacente
   320                                  
   321                                  %%es_soldado:
   322                                          ; Desplazo en la misma direccion 1 mas
   323                                          mov al, [x]
   324                                          add al, [i]
   325                                          mov [x], al
   326                                  
   327                                          mov al, [y]
   328                                          add al, [j]
   329                                          mov [y], al
   330                                  
   331                                          ; si es vacia es valida
   332                                          obtener_posicion_vector_matriz       x,y,CANT_COL 
   333                                          mov dl, BYTE [matriz+rax]                       ; asigno a dl, el caracter de la matriz
   334                                          
   335                                          mov al, [x]
   336                                          sub al, [i]
   337                                          mov [x], al
   338                                  
   339                                          mov al, [y]
   340                                          sub al, [j]
   341                                          mov [y], al
   342                                  
   343                                          cmp dl, [pos_vacia]
   344                                          je %%mostrar_comer
   345                                         
   346                                  %%siguiente_posicion_adyacente:
   347                                          inc     BYTE    [j]
   348                                          cmp     BYTE    [j],    1
   349                                          jle     %%columnas        ; si j es <=1 volvemos a repetir con j+1
   350                                          
   351                                          inc     BYTE    [i]     
   352                                          cmp     BYTE    [i],    1
   353                                          jg      %%fin             ; si i es >1 terminamos
   354                                  
   355                                          jmp      %%filas    
   356                                  
   357                                  %%mostrar_comer: 
   358                                          print_opcione_moviento  opcion_comer, longitud_posiciones_mov, x, y
   359                                  
   360                                          mov BYTE [oficial_comer], 1
   361                                          
   362                                          obtener_posicion_vector_matriz       x,y,CANT_COL
   363                                          jmp     %%añadir_movimiento
   364                                  
   365                                  %%mostrar_oficial: 
   366                                          jmp     %%siguiente_posicion_adyacente
   367                                  
   368                                  %%fin:
   369                                  %endmacro
   370                                  ; -----------------------------------------------------------
   371                                  
   372                                  ; Imprime las opciones y solicita la opcion a mover
   373                                  ; -----------------------------------------------------------
   374                                  amover_oficial:
   375                                  %macro mover_oficial 0
   376                                  %%solicitar_opciones:
   377                                          obtener_pos_validas_oficial    fil, col        ; bucas las posiciones validas para las coordenadas (x,y) en este cado (6,2)
   378                                          leer_opcion
   379                                  
   380                                          cmp BYTE [opcion_ingresada], 0
   381                                          jl %%invalida
   382                                          
   383                                          mov al, BYTE [longitud_posiciones_mov]
   384                                          cmp BYTE [opcion_ingresada], al
   385                                          jge %%invalida
   386                                  
   387                                          jmp %%valida
   388                                  %%invalida:
   389                                          print_s opcion_incorrecta
   390                                          jmp %%solicitar_opciones
   391                                  
   392                                  %%valida:
   393                                          movzx rdi, BYTE [opcion_ingresada]
   394                                          movzx rsi, BYTE [posiciones_mov + rdi] ; rsi = posicion destino
   395                                          
   396                                          mov al, BYTE [matriz + rsi] ; al = caracter en la posicion destino
   397                                          
   398                                          cmp al, [pos_vacia]
   399                                          je %%mover
   400                                  
   401                                  %%comer:
   402                                          ; posion vacia en el destino soldado
   403                                          mov bl, BYTE [pos_vacia]
   404                                          mov BYTE [matriz + rsi], bl
   405                                          dec BYTE   [soldados_vivos]     ; decremento la cantidad de soldados vivos
   406                                          
   407                                          ; pisa en la posicion de la matriz con el oficial
   408                                          obtener_posicion_vector_matriz    fil,col, CANT_COL ; al = posicion original
   409                                          
   410                                          mov bl, sil             ; bl = y 
   411                                          sub bl, al              ; bl = y - x
   412                                          imul rbx, 2             ; bl = 2(y-x)
   413                                          add bl, al              ; bl = x + 2(y-x)
   414                                          movzx rsi, bl           ; rsi = x + 2(y-x)
   415                                  
   416                                          mov BYTE [oficial_comer], 0
   417                                  
   418                                  %%mover:
   419                                          cmp BYTE [oficial_comer], 1
   420                                          je %%borrar
   421                                  
   422                                          ; pisa en la posicion de destino con el jugador
   423                                          mov bl, BYTE [jugador] 
   424                                          mov BYTE [matriz + rsi], bl
   425                                  
   426                                  %%borrar: 
   427                                          ; Borrar al oficial de la posicion original dejando un carater vacio
   428                                          obtener_posicion_vector_matriz    fil,col, CANT_COL
   429                                          mov bl, BYTE [jugador]
   430                                          cmp bl, [soldado]
   431                                          je %%continua
   432                                  
   433                                          mov cl, 0
   434                                  %%busca_posicion_oficial:
   435                                          cmp BYTE [posiciones_oficiales + rcx], al
   436                                          je %%encontro
   437                                  
   438                                          inc cl
   439                                          jmp %%busca_posicion_oficial
   440                                  
   441                                  %%encontro:
   442                                          mov BYTE [posiciones_oficiales + rcx], sil ; actualizo la posicion del oficial
   443                                  
   444                                  %%continua:
   445                                          mov bl, BYTE [pos_vacia]
   446                                          mov BYTE [matriz + rax], bl
   447                                  
   448                                          cmp BYTE [oficial_comer], 0
   449                                          je %%fin
   450                                  
   451                                          mov BYTE [posiciones_oficiales + rcx], 0
   452                                          cmp BYTE [oficial_comer], 0
   453                                          dec BYTE [oficiales_vivos] 
   454                                  %%fin:
   455                                  %endmacro
   456                                  ; -----------------------------------------------------------
   457                                  
   458                                  
   459                                  ;Seleccionar la pos de un oficial
   460                                  ; -----------------------------------------------------------
   461                                  ;  %1 : cadena para pedir coedenadas del jugador actual
   462                                  ;  %2 : caracter de personaje actual (oficial o soldado)
   463                                  aingres_oficial:
   464                                  %macro ingresar_coordenadas_jugador 2
   465                                  %%solicitar_posicion:
   466                                          ;solicitar la fila y columna del oficial que desea jugar
   467                                          print_s %1
   468                                          print_s mensaje_fila
   469                                          leer_opcion
   470                                          mov al, BYTE [opcion_ingresada]
   471                                          mov BYTE [fil], al
   472                                  
   473                                          print_s mensaje_columna
   474                                          leer_opcion
   475                                          mov al, BYTE [opcion_ingresada]
   476                                          mov BYTE [col], al
   477                                  
   478                                          obtener_posicion_vector_matriz    fil, col, CANT_COL
   479                                          mov al, BYTE [matriz + rax]
   480                                          cmp al, [%2]
   481                                          je %%fin
   482                                          print_s opcion_incorrecta
   483                                          jmp %%solicitar_posicion
   484                                  %%fin:
   485                                  %endmacro
   486                                  ; -----------------------------------------------------------
   487                                  
   488                                  ; Revisa si el cuartel esta lleno de soldados
   489                                  ; -----------------------------------------------------------
   490                                  revi_cuar:
   491                                  %macro revisar_cuartel 0
   492                                          mov rcx, 0
   493                                  %%iterar_cuartel:
   494                                          mov al, BYTE [cuartel + rcx]
   495                                          mov al, BYTE [matriz + rax]
   496                                          cmp al, [soldado]
   497                                          jne %%fin
   498                                  
   499                                          inc cl
   500                                          cmp cl, 9
   501                                          jl %%iterar_cuartel
   502                                  
   503                                          print_s mensaje_gano_soldados
   504                                          jmp final_juego
   505                                  
   506                                  %%fin:
   507                                  %endmacro
   508                                  ; -----------------------------------------------------------
   509                                  
   510                                  %macro revisar_oficiales 0
   511                                          mov cl, 0
   512                                  %%iterar_oficiales:
   513                                          mov al, BYTE [posiciones_oficiales + rcx] ; al posicion oficial
   514                                  	mov BYTE [i], -1
   515                                          mov BYTE [j], -1  
   516                                  
   517                                  %%iterar_adyacentes:
   518                                          mov bl, [i] ; bl = i
   519                                          imul rbx, 7  ; bl = i*7 = i*d
   520                                          add bl, [j] ; bl = i*d + j
   521                                          add bl, al  ; bl = n + i*d + j
   522                                          
   523                                          movzx rbx, bl
   524                                  
   525                                          cmp bl, al  ; si la posicion adyacente es la misma que la original
   526                                          je %%next
   527                                          cmp bl, 0
   528                                          jle %%next ; si la posicion adyacente es menor o igual a 0
   529                                          cmp bl, 48
   530                                          jg %%next ; si la posicion adyacente es mayor a 48
   531                                  
   532                                          mov bl, byte [matriz + rbx] ; bl = matriz[n + i*d + j]
   533                                          cmp bl, [soldado] ; si la posicion adyacente es un soldado
   534                                          je %%next
   535                                  
   536                                          cmp bl, [pos_invalida] ; si la posicion adyacente es invalida
   537                                          je %%next
   538                                  
   539                                          jmp %%no_rodeado
   540                                  %%next:
   541                                          inc BYTE [j]
   542                                          cmp BYTE [j], 2
   543                                          jl %%iterar_adyacentes
   544                                          mov BYTE [j], -1
   545                                          inc BYTE [i]
   546                                          cmp BYTE [i], 2
   547                                          jl %%iterar_adyacentes
   548                                  
   549                                          jmp %%rodeado
   550                                  
   551                                  %%no_rodeado:
   552                                          mov BYTE [oficiales_rodeados + rcx], 0
   553                                          jmp %%siguiente_oficial
   554                                  
   555                                  %%rodeado:
   556                                          mov BYTE [oficiales_rodeados + rcx], 1
   557                                  
   558                                  %%siguiente_oficial:
   559                                          inc cl
   560                                          cmp cl, 2 
   561                                          jl %%iterar_oficiales
   562                                  
   563                                  %%verificar_todos_rodeados:
   564                                          mov cl, 0
   565                                  %%iterar_oficiales_rodeados:
   566                                          mov al, [oficiales_rodeados + rcx]
   567                                          cmp al, 0
   568                                          je %%fin
   569                                  
   570                                          inc cl
   571                                          cmp cl, 2
   572                                          jl %%iterar_oficiales_rodeados     
   573                                  
   574                                          print_s mensaje_perdio_oficiales_rodeados
   575                                          jmp final_juego
   576                                  %%fin:
   577                                  %endmacro
   578                                  
   579                                  ; Verifica los casos de victoria
   580                                  ; -----------------------------------------------------------
   581                                  %macro verificar_victoria 0
   582                                          cmp BYTE [oficiales_vivos], 0
   583                                          je %%perdio_oficiales
   584                                  
   585                                          cmp BYTE [soldados_vivos], 9
   586                                          jl %%perdio_soldados
   587                                          
   588                                          revisar_cuartel
   589                                  
   590                                          revisar_oficiales
   591                                  
   592                                          jmp %%fin
   593                                  
   594                                  %%perdio_oficiales:
   595                                          print_s mensaje_perdio_oficiales
   596                                          jmp final_juego
   597                                  
   598                                  %%perdio_soldados:
   599                                          print_s mensaje_perdio_soldados
   600                                          jmp final_juego
   601                                  
   602                                  %%fin:
   603                                  %endmacro
   604                                  
   605                                  
   606                                  ; -----------------------------------------------------------
   607                                  ; fil y col tienen las coordenadas del soldado
   608                                  %macro obtener_pos_validas_soldado 0    
   609                                          mov BYTE [longitud_posiciones_mov], 0
   610                                          mov BYTE [posiciones_mov], 0
   611                                  
   612                                          ; si el soldado esta en una posicion roja
   613                                          obtener_posicion_vector_matriz  fil,col,CANT_COL
   614                                          mov     rcx,0
   615                                  %%buscar_soldados_rojos:
   616                                          cmp al, BYTE [posiciones_limitadas+rcx]
   617                                          je  %%soldado_rojo
   618                                  %%seguir:
   619                                          inc     rcx
   620                                          cmp rcx, 4
   621                                          jl     %%buscar_soldados_rojos
   622                                          jmp     %%soldados_normales
   623                                  
   624                                  %%soldado_rojo:
   625                                          cmp     BYTE [col],3
   626                                          jl      %%suma_columna
   627                                          dec     BYTE [col]
   628                                          jmp     %%proseguir
   629                                  %%suma_columna:
   630                                          inc     BYTE [col]
   631                                  %%proseguir:
   632                                          obtener_posicion_vector_matriz  fil,col,CANT_COL
   633                                          mov     dl , [matriz+rax]
   634                                          cmp     dl, BYTE [pos_vacia]
   635                                          jne      %%fin                               ; si es distinto de vacio siguo con la siguiente pos del vector de pos limitadas 
   636                                  
   637                                          print_opcione_moviento          opcion_vacia, longitud_posiciones_mov,fil,col
   638                                          movzx   rdi, BYTE [longitud_posiciones_mov]
   639                                          mov     BYTE [posiciones_mov + rdi], al
   640                                          inc     BYTE [longitud_posiciones_mov]
   641                                          jmp     %%fin
   642                                  
   643                                  %%soldados_normales:
   644                                          mov cl ,-1 ; contador aux
   645                                          inc BYTE [fil]
   646                                  
   647                                  %%iterar_pos_soldados:
   648                                          add     BYTE [col],cl
   649                                  
   650                                          obtener_posicion_vector_matriz   fil,col,CANT_COL ; en al se encuentra la direccion
   651                                          mov   dl , [matriz+rax]
   652                                          cmp   dl,BYTE [pos_vacia]
   653                                          jne   %%continuar                       ; si es distinto de vacio , analizo la proxima posicion
   654                                  
   655                                          print_opcione_moviento          opcion_vacia, longitud_posiciones_mov,fil,col
   656                                          movzx   rdi, BYTE [longitud_posiciones_mov]
   657                                          mov     BYTE [posiciones_mov + rdi], al
   658                                          inc     BYTE [longitud_posiciones_mov]
   659                                          
   660                                  %%continuar:
   661                                          inc   cl
   662                                          cmp   cl, 2
   663                                          jl   %%iterar_pos_soldados 
   664                                  %%fin:
   665                                  %endmacro
   666                                  
   667                                  %macro mover_soldados 0
   668                                  
   669                                          obtener_pos_validas_soldado
   670                                  
   671                                  %endmacro
