   197                                  ;imprimir pos validas para oficial=> 
   198                                  ;%1 : fil,%2:col 
   199                                  %macro imprimir_pos_validas 2
   200                                  
   201                                          mov     BYTE    [i],    -1    
   202                                          mov     BYTE    [j],    -1
   203                                          mov     r12B,    %1    ;fila
   204                                          mov     r13B,    %2      ;col
   205                                          mov     [x],     r12B
   206                                          mov     [y],     r13B
   207                                  %%filas:
   208                                          cmp     BYTE    [i],    1
   209                                          jg      %%fin             ;fin del analisis
   210                                  
   211                                          mov     [x],     r12B
   212                                          mov     r8B,     [i]
   213                                          add     [x],    r8B
   214                                  %%columnas:
   215                                          mov     [y],     r13B
   216                                          mov     r8B,     [j]
   217                                          add     [y],    r8B
   218                                  
   219                                          calcular_direccion_de_una_posicion       x,y,CANT_COL    ;pos en al
   220                                          mov     rcx,    17
   221                                  %%posiciones_invalidas:
   222                                          movzx   r8,     BYTE [dirrecciones_invalidas+rcx]
   223                                          cmp     rax,    r8 
   224                                          je      %%continuar
   225                                          loop    %%posiciones_invalidas 
   226                                          ; la pos es valida 
   227                                          mov     dl,    [pos_vacia]
   228                                          cmp     BYTE    [matriz+ rax],          dl           
   229                                          je      %%pos_valida
   230                                  %%continuar:
   231                                          inc     BYTE    [j]
   232                                          cmp     BYTE    [j],    1
   233                                          jle     %%columnas        ; si j es <=1 volvemos a repetir con j+1
   234                                          inc     BYTE    [i]
   235                                          mov     BYTE    [j],    -1
   236                                          jmp      %%filas           ; si j >1, incrementamos i ,y volvemos a filas
   237                                  
   238                                  
   239                                  %%pos_valida:
   240                                          cmp     [x],    r12B
   241                                          jl      fila_menor
   242                                          je      fila_igual
   243                                          jg      fila_mayor
   244                                  
   245                                  fila_mayor:
   246                                          cmp     [y],    r13B
   247                                          jg      poner_inf_derecha
   248                                          je      poner_inf_abajo
   249                                          jl      poner_inf_izquierda
   250                                  
   251                                  fila_igual:
   252                                          cmp     [y],    r13B
   253                                          jl      poner_izquierda
   254                                          jg      poner_derecha
   255                                  
   256                                  fila_menor:
   257                                          cmp     [y],    r13B
   258                                          jg      poner_sup_derecha
   259                                          je      poner_sup_arriba
   260                                          jl      poner_sup_izquierda
   261                                  
   262                                  poner_inf_derecha:
   263                                          imprimir_opcion     opcion_inf_derecha
   264                                          jmp     %%continuar
   265                                  poner_inf_abajo:
   266                                          imprimir_opcion     opcion_abajo
   267                                          jmp     %%continuar
   268                                  
   269                                  poner_inf_izquierda:
   270                                          imprimir_opcion     opcion_inf_izquierda
   271                                          jmp     %%continuar
   272                                  
   273                                  poner_derecha:
   274                                          imprimir_opcion     opcion_derecha
   275                                          jmp     %%continuar
   276                                  
   277                                  poner_izquierda:
   278                                          imprimir_opcion     opcion_izquierda
   279                                          jmp     %%continuar
   280                                  
