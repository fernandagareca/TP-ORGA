   175                                  ; Imprime la matriz: 
   176                                  ; Props:  
   177                                  ;   %1: matriz 
   178                                  ; -----------------------------------------------------------
   179                                  imprimir:
   180                                  %macro imprimir_matriz 0
   181                                  
   182                                          mov     BYTE [i], 0                     ; Inicializar fila 1
   183                                          mov     BYTE [j], 0                     ; Inicializar columna 1
   184                                  
   185                                          mov     rdi,mensaje_cant_soldados  
   186                                          mprintf
   187                                          mov     rdi,formato_contador  
   188                                          movzx   rsi, byte [soldados_vivos] 
   189                                          mprintf
   190                                          mputs      salto_linea
   191                                  
   192                                  
   193                                          mputs         linea_posiciones          ; Imprime tope
   194                                          mputs         linea_arriba              ; Imprime tope
   195                                          mov     rdi,formato_contador  
   196                                          movzx   rsi, byte [i] 
   197                                          mprintf        
   198                                          print_s       linea_vertical            ; Imprime primer borde izquierdo        
   199                                  
   200                                  %%inicio:
   201                                          cmp     BYTE [j],      CANT_COL          ; Verificar si se llegó al final de las columnas
   202                                          je      %%cambioFila
   203                                  
   204                                          ; Imprimir el carácter de la posicion i,j 
   205                                          obtener_posicion_vector_matriz      i,j,CANT_COL ; rax = posicion del vector
   206                                          mov   rdi,formato  
   207                                          movzx   rsi, byte [matriz + rax] 
   208                                          mprintf   
   209                                  
   210                                          inc     BYTE [j]
   211                                          jmp     %%inicio
   212                                  
   213                                  %%cambioFila:
   214                                          print_s        linea_vertical           ; imprime borde derecho
   215                                          print_s        salto_linea
   216                                  
   217                                          inc     BYTE [i]                        ; Ir a la siguiente fila
   218                                          cmp     BYTE [i],      CANT_FIL         ; Verificar si se llegó al final de las filas
   219                                          je      %%fin
   220                                  
   221                                          mov     rdi,formato_contador  
   222                                          movzx   rsi, byte [i] 
   223                                          mprintf    
   224                                          print_s        linea_vertical           ; Imprime borde izquierdo nueva fila
   225                                          mov     BYTE    [j],   0                ; Reiniciar columna
   226                                          jmp     %%inicio
   227                                  %%fin:
   228                                          mputs         linea_abajo               ; Imprime borde inferior
   229                                  %endmacro
