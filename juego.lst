     8                                  ;cancular direccion : %1 : fil %2 :col, %3: cantidad_columnas
     9                                  %macro calcular_direccion_de_una_posicion 3
    10                                          movzx   rax,    BYTE [%1]              ; rax = fila (ampliar a 64 bits para cálculos)
    11                                          dec     al                          ; fila - 1
    12                                          imul    rax,    %3                     ; (fila - 1) * CANT_COL
    13                                          movzx   rbx,    BYTE [%2]              ; rbx = columna (ampliar a 64 bits)
    14                                          add     rax,    rbx                    ; (fila - 1) * CANT_COL + columna
    15                                          dec     al                          ; índice base 0
    16                                  %endmacro
