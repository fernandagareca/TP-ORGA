     1                                  global main
     2                                  extern printf;    imprimir_matriz formato, saltoLinea,matriz,CANT_COL,CANT_FIL,i,j
     3                                  extern scanf
     4                                  extern puts
     5                                  extern strcpy
     6                                  extern strcmp
     7                                  ;cancular direccion : %1 : fil %2 :col, %3: cantidad_columnas
     8                                  %macro calcular_direccion_de_una_posicion 3
     9                                          movzx   rax,    BYTE [%1]              ; rax = fila (ampliar a 64 bits para cálculos)
    10                                          dec     al                          ; fila - 1
    11                                          imul    rax,    %3                     ; (fila - 1) * CANT_COL
    12                                          movzx   rbx,    BYTE [%2]              ; rbx = columna (ampliar a 64 bits)
    13                                          add     rax,    rbx                    ; (fila - 1) * CANT_COL + columna
    14                                          dec     al                          ; índice base 0
    15                                  %endmacro
    16                                  ; imprime la matriz => 
    17                                  ;%1 : fomato para imprimir, %2: cadena de salto de linea, %3:matriz  %4:cantidad de columnas %5: cantidad de filas %6: indice fil fila %7: indice col 
    18                                  %macro imprimir_matriz 7
    19                                          mov     BYTE [%6],      1           ; Inicializar fila (1 byte)
    20                                          mov     BYTE [%7],      1           ; Inicializar columna (1 byte)
    21                                  
    22                                  %%inicio:
    23                                          cmp     BYTE [%6],      %5          ; Verificar si se llegó al final de las filas
    24                                          jg      %%fin
    25                                  
    26                                          cmp     BYTE [%7],      %4          ; Verificar si se llegó al final de las columnas
    27                                          jg      %%cambioFila
    28                                  
    29                                          calcular_direccion_de_una_posicion      %6,%7,%4
    30                                  
    31                                          movzx   rdx, BYTE [%3 + rax]        ; Cargar carácter desde matriz
    32                                  
    33                                          ; Imprimir el carácter
    34                                          sub     rsp,    8
    35                                          mov     rdi,    %1
    36                                          mov     rsi,    rdx                    ; El carácter se pasa en rsi
    37                                          xor     rax,    rax                    ; Limpiar rax para printf
    38                                          call    printf
    39                                          add     rsp,    8
    40                                  
    41                                          inc     BYTE [%7]
    42                                          jmp     %%inicio
    43                                  
    44                                  %%cambioFila:
    45                                          ; Imprimir salto de línea
    46                                          sub     rsp,    8
    47                                          mov     rdi,    %2
    48                                          xor     rax,    rax                    ; Limpiar rax para printf
    49                                          call    printf
    50                                          add     rsp,    8
    51                                  
    52                                          inc     BYTE    [%6]                   ; Ir a la siguiente fila
    53                                          mov     BYTE    [%7],   1                ; Reiniciar columna
    54                                          jmp     %%inicio
    55                                  
    56                                  %%fin:
    57                                  %endmacro
    58                                  
    59                                  ; imprime las opciones que hay => en %1 esta el vector, en %2 esta la cantidad de elementos, %3: cadena para pedir
    60                                  %macro mostrarOpciones 3
    61                                          sub     rsp,    8 
    62                                          mov     rdi,    %3
    63                                          call    puts
    64                                          add     rsp,    8 
    65                                          mov     rbx,    %2
    66                                  opcionesJugada:
    67                                          cmp     rbx,    0
    68                                          jle      finOpciones
    69                                  
    70                                          lea     rdi,    [%1]      ; Dirección del vector destino
    71                                          sub     rsp,    8 
    72                                          call    puts              ; Llamar a strcpy para copiar la cadena
    73                                          add     rsp,    8 
    74                                          dec     rbx
    75                                          jmp     opcionesJugada
    76                                  
    77                                  finOpciones:
    78                                  %endmacro
    79                                  ;ejecuta la instruccion ingresada => %1 : opcion ingresada, %2 : opcion
    80                                  %macro ejecutar_intruccion 2
    81                                  
    82                                          mov     rdi,    %1
    83                                          mov     rsi,    %2
    84                                          sub     rsp,    8 
    85                                          call    strcmp
    86                                          add     rsp,    8 
    87                                          cmp     rax,     0; son iguales
    88                                          je      final
    89                                  %endmacro
    90                                  ;voltea la matriz hacia abajo %1 matriz fuente, %2: matriz destino
    91                                  %macro tablero_vertical 2
    92                                          mov     rdi,    0       ;direccion inicio
    93                                          mov     rsi,    48     ;direccion final 
    94                                  %%espejo:
    95                                          cmp     rdi,   rsi
    96                                          jg      %%fin
    97                                          mov     al, [%1 + rdi]   ; inicio
    98                                          mov     dl, [%1 + rsi]   
    99                                  
   100                                          mov     [%2 + rdi], dl
   101                                          mov     [%2 + rsi], al
   102                                  
   103                                          inc     rdi
   104                                          dec     rsi
   105                                          jmp     %%espejo
   106                                  
   107                                  %%fin:
   108                                  %endmacro   
   109                                  
   110                                  ;rotar derecha =>  %1:i,%2:j,%3:CANT_FIL,%4:CANT_COL,%5:matriz,%6:tablero_rotacion_derecha
   111                                  %macro rotar_derecha 6
   112                                          mov     BYTE [%1],      1
   113                                          mov     BYTE [%2],      1
   114                                  %%inicio:
   115                                          cmp     BYTE [%1],      %3          
   116                                          jg      %%aca
   117                                  
   118                                          cmp     BYTE [%2],      %4        
   119                                          jg      %%cambioFila
   120                                  
   121                                  
   122                                          calcular_direccion_de_una_posicion  %2,%1,%4
   123                                          movzx   rdx, BYTE [%5 + rax]   
   124                                  
   125                                  
   126                                          calcular_direccion_de_una_posicion %1,%2, %4
   127                                          mov     [%6 + rax], rdx  
   128                                  
   129                                          inc     BYTE [%2]                   
   130                                          jmp     %%inicio                     
   131                                  
   132                                  %%cambioFila:
   133                                          inc     BYTE [%1]                  
   134                                          mov     BYTE [%2],    1            
   135                                          jmp     %%inicio
   136                                  %%aca:
   137                                  %endmacro
