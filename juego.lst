    74                                  ;rotar derecha =>  %1:matriz,%2:tablero_rotacion_derecha
    75                                  %macro rotar_derecha 2
    76                                          mov     BYTE [i],      1
    77                                          mov     BYTE [j],      1
    78                                  %%inicio:
    79                                          cmp     BYTE [i],      CANT_FIL          
    80                                          jg      %%aca
    81                                  
    82                                          cmp     BYTE [j],      CANT_COL        
    83                                          jg      %%cambioFila
    84                                  
    85                                          calcular_direccion_de_una_posicion  j,i,CANT_COL
    86                                          movzx   rdx, BYTE [%1 + rax]   
    87                                  
    88                                          calcular_direccion_de_una_posicion i,j, CANT_COL
    89                                          mov     [%2 + rax], rdx  
    90                                  
    91                                          inc     BYTE [j]                   
    92                                          jmp     %%inicio                     
    93                                  
    94                                  %%cambioFila:
    95                                          inc     BYTE [i]                  
    96                                          mov     BYTE [j],    1            
    97                                          jmp     %%inicio
    98                                  %%aca:
    99                                  %endmacro
   100                                  
   101                                  ; imprime la matriz => %1 :matriz 
   102                                  %macro imprimir_matriz 1
   103                                          mov     BYTE [i],      1           ; Inicializar fila (1 byte)
   104                                          mov     BYTE [j],      1           ; Inicializar columna (1 byte)
   105                                          imprimir_opcion         linea_arriba
   106                                          imprimir        linea_vertical
   107                                  
   108                                  %%inicio:
   109                                          cmp     BYTE [i],      CANT_FIL          ; Verificar si se llegó al final de las filas
   110                                          jg      %%fin
   111                                          cmp     BYTE [j],      CANT_COL          ; Verificar si se llegó al final de las columnas
   112                                          jg      %%cambioFila
   113                                          calcular_direccion_de_una_posicion      i,j,CANT_COL
   114                                  
   115                                          movzx   rdx, BYTE [%1 + rax]        ; Cargar carácter desde matriz
   116                                          ; Imprimir el carácter
   117                                          sub     rsp,    8
   118                                          mov     rdi,   formato
   119                                          mov     rsi,    rdx                    ; El carácter se pasa en rsi
   120                                          call    printf
   121                                          add     rsp,    8
   122                                  
   123                                          inc     BYTE [j]
   124                                          jmp     %%inicio
   125                                  
   126                                  %%cambioFila:
   127                                          imprimir        linea_vertical
   128                                          imprimir        saltoLinea
   129                                          imprimir        linea_vertical
   130                                  
   131                                          inc     BYTE    [i]                   ; Ir a la siguiente fila
   132                                          mov     BYTE    [j],   1                ; Reiniciar columna
   133                                          jmp     %%inicio
   134                                  %%fin:
   135                                          imprimir_opcion         linea_abajo
   136                                  %endmacro
   137                                  %macro imprimir_opcion 1
   138                                          mov     rdi,%1       
   139                                          sub     rsp,    8 
   140                                          call    puts           
   141                                          add     rsp,    8 
   142                                  %endmacro
   143                                  %macro imprimir 1
   144                                          mov     rdi,%1       
   145                                          sub     rsp,    8 
   146                                          call    printf           
   147                                          add     rsp,    8 
   148                                  %endmacro
   149                                  ;imprimir pos validas para oficial=> %1 : fil,%2:col 
   150                                  %macro imprimir_pos_validas 2
   151                                          imprimir_opcion      opcion_salir
   152                                          mov     BYTE    [i],    -1    
   153                                          mov     BYTE    [j],    -1      
   154                                          mov     r12B,    %1    ;fila
   155                                          mov     r13B,    %2      ;col
   156                                          mov     [x],     r12B
   157                                          mov     [y],     r13B
   158                                  %%filas:
   159                                          cmp     BYTE    [i],    1
   160                                          jg      %%fin             ;fin del analisis
   161                                  
   162                                          mov     [x],     r12B
   163                                          mov     r8B,     [i]
   164                                          add     [x],    r8B
   165                                  %%columnas:
   166                                          mov     [y],     r13B
   167                                          mov     r8B,     [j]
   168                                          add     [y],    r8B
   169                                  
   170                                          calcular_direccion_de_una_posicion       x,y,CANT_COL    ;pos en al
   171                                          mov     rcx,    17
   172                                  %%posiciones_invalidas:
   173                                          movzx   r8,     BYTE [dirrecciones_invalidas+rcx]
   174                                          cmp     rax,    r8 
   175                                          je      %%continuar
   176                                          loop    %%posiciones_invalidas 
   177                                          ; la pos es valida 
   178                                          mov     dl,    [pos_vacia]
   179                                          cmp     BYTE    [matriz+ rax],          dl           
   180                                          je      %%pos_valida
   181                                  %%continuar:
   182                                          inc     BYTE    [j]
   183                                          cmp     BYTE    [j],    1
   184                                          jle     %%columnas        ; si j es <=1 volvemos a repetir con j+1
   185                                          inc     BYTE    [i]
   186                                          mov     BYTE    [j],    -1
   187                                          jmp      %%filas           ; si j >1, incrementamos i ,y volvemos a filas
   188                                  
   189                                  
   190                                  %%pos_valida:
   191                                          cmp     [x],    r12B
   192                                          jl      %%fila_menor
   193                                          je      %%fila_igual
   194                                          jg      %%fila_mayor
   195                                  
   196                                  %%fila_mayor:
   197                                          cmp     [y],    r13B
   198                                          jg      %%poner_inf_derecha
   199                                          je      %%poner_inf_abajo
   200                                          jl      %%poner_inf_izquierda
   201                                  
   202                                  %%fila_igual:
   203                                          cmp     [y],    r13B
   204                                          jl      %%poner_izquierda
   205                                          jg      %%poner_derecha
   206                                  
   207                                  %%fila_menor:
   208                                          cmp     [y],    r13B
   209                                          jg      %%poner_sup_derecha
   210                                          je      %%poner_sup_arriba
   211                                          jl      %%poner_sup_izquierda
   212                                  
   213                                  %%poner_inf_derecha:
   214                                          imprimir_opcion     opcion_inf_derecha
   215                                          jmp     %%continuar
   216                                  %%poner_inf_abajo:
   217                                          imprimir_opcion     opcion_abajo
   218                                          jmp     %%continuar
   219                                  
   220                                  %%poner_inf_izquierda:
   221                                          imprimir_opcion     opcion_inf_izquierda
   222                                          jmp     %%continuar
   223                                  
   224                                  %%poner_derecha:
   225                                          imprimir_opcion     opcion_derecha
   226                                          jmp     %%continuar
   227                                  
   228                                  %%poner_izquierda:
   229                                          imprimir_opcion     opcion_izquierda
   230                                          jmp     %%continuar
   231                                  
   232                                  %%poner_sup_izquierda:
   233                                          imprimir_opcion     opcion_sup_izquierda
   234                                          jmp     %%continuar
   235                                  
   236                                  %%poner_sup_arriba:
   237                                          imprimir_opcion     opcion_arriba
   238                                          jmp     %%continuar
   239                                  
   240                                  %%poner_sup_derecha:
   241                                          imprimir_opcion     opcion_sup_derecha
   242                                          jmp     %%continuar
   243                                  
   244                                  %%fin:
   245                                  %endmacro
   246                                  
   247                                  ;voltea la matriz hacia abajo %1 matriz fuente, %2: matriz destino
   248                                  %macro tablero_vertical 2
   249                                          mov     rdi,    0       ;direccion inicio
   250                                          mov     rsi,    48     ;direccion final 
   251                                  %%espejo:
   252                                          cmp     rdi,   rsi
   253                                          jg      %%fin_tablero_espejo
   254                                          mov     al, [%1 + rdi]   ; inicio
   255                                          mov     dl, [%1 + rsi]   
   256                                  
   257                                          mov     [%2 + rdi], dl
   258                                          mov     [%2 + rsi], al
   259                                  
   260                                          inc     rdi
   261                                          dec     rsi
   262                                          jmp     %%espejo
   263                                  
   264                                  %%fin_tablero_espejo:
   265                                  %endmacro   
   266                                  ; => %1 : opcion ingresada, %2 : opcion a comparar
   267                                  %macro  comparar_opciones 2
   268                                          mov     al,    [%1]
   269                                          mov     bl,    %2
   270                                          cmp     al,    bl
   271                                  %endmacro
   272                                  
   273                                  %macro copiar_matriz 1
   274                                          mov     rcx,    0
   275                                  %%inicio:
   276                                          cmp     rcx,    49
   277                                          jg      %%fin
   278                                          mov     al,     [%1+ rcx]
   279                                          mov     [tablero+rcx], al
   280                                          inc     rcx
   281                                          jmp     %%inicio
   282                                  %%fin:
   283                                  %endmacro
   284                                  %macro  limpiar 0
   285                                          mov     rdi,    cmd_clear
   286                                          sub     rsp,    8
   287                                          call    system
   288                                          add     rsp,    8
   289                                  %endmacro
   290                                  ;ejecuta la instruccion ingresada => %1 : opcion ingresada, %2 : opcion
   291                                  %macro ejecutar_intruccion 1
   292                                          mov     bl,    [opcion_ingresada]
   293                                          mov     al,   104       ; codigo h
   294                                          cmp     al,    bl
   295                                          je      final_juego             ;salir
   296                                  
   297                                          mov     al,    49       ; codigo 1
   298                                          cmp     al,    bl
   299                                          je      %%arriba                ;mismo tablero
   300                                  
   301                                          mov     al,    50       ;codigo 2
   302                                          cmp     al,    bl
   303                                          je      %%izquierda
   304                                  
   305                                          mov     al,    51       ;codigo 3
   306                                          cmp     al,    bl
   307                                          je      %%derecha               ;rotar derecha
   308                                  
   309                                          mov     al,    52       ;codigo 4
   310                                          cmp     al,    bl
   311                                          je      %%abajo                 ;rotar abajo
   312                                          jmp     %%incorrecto
   313                                  %%incorrecto:
   314                                          limpiar
   315                                          imprimir_opcion        opcion_incorrecta
   316                                          jmp     pedir_tablero
   317                                  %%arriba:
   318                                          copiar_matriz           matriz
   319                                          jmp     %%fin
   320                                  %%derecha:
   321                                          rotar_derecha           matriz, tablero
   322                                          jmp     %%fin
   323                                  %%abajo:
   324                                          tablero_vertical        matriz, tablero
   325                                          jmp     %%fin
   326                                  %%izquierda:
   327                                          rotar_derecha           matriz, tablero_rotacion_derecha
   328                                          tablero_vertical          tablero_rotacion_derecha,tablero
   329                                          jmp     %%fin
   330                                  %%fin:
   331                                  
   332                                  %endmacro
   333                                  
   334                                  ; => %1 : 
   335                                  %macro leer_entrada 0
   336                                          sub     rsp,    8 
   337                                          mov     rdi,    formato_Caracter
   338                                          mov     rsi,     opcion_ingresada
   339                                          call    scanf           ; espera a que ingreses una opcion
   340                                          add     rsp,    8 
   341                                  %endmacro
