     1                                  global main
     2                                  extern printf;    imprimir_matriz formato, saltoLinea,matriz,CANT_COL,CANT_FIL,i,j
     3                                  extern scanf
     4                                  extern puts
     5                                  extern strcpy
     6                                  extern strcmp
     7                                  ;cancular direccion : %1 : fil %2 :col, %3: cantidad_columnas
     8                                  %macro calcular_direccion_de_una_posicion 3
     9                                          movzx   rax,    BYTE [%1]              ; rax = fila (ampliar a 64 bits para cálculos)
    10                                          dec     al                          ; fila - 1
    11                                          imul    rax,    %3                     ; (fila - 1) * CANT_COL
    12                                          movzx   rbx,    BYTE [%2]              ; rbx = columna (ampliar a 64 bits)
    13                                          add     rax,    rbx                    ; (fila - 1) * CANT_COL + columna
    14                                          dec     al                          ; índice base 0
    15                                  %endmacro
    16                                  ; imprime la matriz => 
    17                                  ;%1 : fomato para imprimir, %2: cadena de salto de linea, %3:matriz  %4:cantidad de columnas %5: cantidad de filas %6: indice fil fila %7: indice col 
    18                                  %macro imprimir_matriz 7
    19                                          mov     BYTE [%6],      1           ; Inicializar fila (1 byte)
    20                                          mov     BYTE [%7],      1           ; Inicializar columna (1 byte)
    21                                  
    22                                  %%inicio:
    23                                          cmp     BYTE [%6],      %5          ; Verificar si se llegó al final de las filas
    24                                          jg      %%fin
    25                                  
    26                                          cmp     BYTE [%7],      %4          ; Verificar si se llegó al final de las columnas
    27                                          jg      %%cambioFila
    28                                  
    29                                          calcular_direccion_de_una_posicion      %6,%7,%4
    30                                  
    31                                          movzx   rdx, BYTE [%3 + rax]        ; Cargar carácter desde matriz
    32                                  
    33                                          ; Imprimir el carácter
    34                                          sub     rsp,    8
    35                                          mov     rdi,    %1
    36                                          mov     rsi,    rdx                    ; El carácter se pasa en rsi
    37                                          xor     rax,    rax                    ; Limpiar rax para printf
    38                                          call    printf
    39                                          add     rsp,    8
    40                                  
    41                                          inc     BYTE [%7]
    42                                          jmp     %%inicio
    43                                  
    44                                  %%cambioFila:
    45                                          ; Imprimir salto de línea
    46                                          sub     rsp,    8
    47                                          mov     rdi,    %2
    48                                          xor     rax,    rax                    ; Limpiar rax para printf
    49                                          call    printf
    50                                          add     rsp,    8
    51                                  
    52                                          inc     BYTE    [%6]                   ; Ir a la siguiente fila
    53                                          mov     BYTE    [%7],   1                ; Reiniciar columna
    54                                          jmp     %%inicio
    55                                  
    56                                  %%fin:
    57                                  %endmacro
    58                                  
    59                                  ; imprime las opciones que hay => en %1 esta el vector, en %2 esta la cantidad de elementos, %3: cadena para pedir
    60                                  %macro mostrarOpciones 3
    61                                          sub     rsp,    8 
    62                                          mov     rdi,    %3
    63                                          call    puts
    64                                          add     rsp,    8 
    65                                          mov     rdx,    0
    66                                          mov     rcx,    %2
    67                                  opcionesJugada:
    68                                          cmp     rcx,    0
    69                                          je      finOpciones
    70                                  
    71                                          lea     rdi,    [%1 + rdx]      ; Dirección del vector destino
    72                                          sub     rsp,    8 
    73                                          call    puts              ; Llamar a strcpy para copiar la cadena
    74                                          add     rsp,    8 
    75                                          dec     rcx
    76                                          inc     rdx
    77                                          jmp     opcionesJugada
    78                                  
    79                                  finOpciones:
    80                                  %endmacro
    81                                  ;ejecuta la instruccion ingresada => %1 : opcion ingresada, %2 : opcion
    82                                  %macro ejecutar_intruccion 2
    83                                  
    84                                          mov     rdi,    %1
    85                                          mov     rsi,    %2
    86                                          sub     rsp,    8 
    87                                          call    strcmp
    88                                          add     rsp,    8 
    89                                          cmp     rax,     0; son iguales
    90                                          je      final
    91                                  %endmacro
    92                                  ;voltea la matriz hacia abajo %1 matriz fuente, %2: matriz destino
    93                                  %macro tablero_vertical 2
    94                                          mov     rdi,    0       ;direccion inicio
    95                                          mov     rsi,    48     ;direccion final 
    96                                  %%espejo:
    97                                          cmp     rdi,   rsi
    98                                          jg      %%fin_tablero_espejo
    99                                          mov     al, [%1 + rdi]   ; inicio
   100                                          mov     dl, [%1 + rsi]   
   101                                  
   102                                          mov     [%2 + rdi], dl
   103                                          mov     [%2 + rsi], al
   104                                  
   105                                          inc     rdi
   106                                          dec     rsi
   107                                          jmp     %%espejo
   108                                  
   109                                  %%fin_tablero_espejo:
   110                                  %endmacro   
   111                                  
   112                                  ;rotar derecha =>  %1:i,%2:j,%3:CANT_FIL,%4:CANT_COL,%5:matriz,%6:tablero_rotacion_derecha
   113                                  %macro rotar_derecha 6
   114                                          mov     BYTE [%1],      1
   115                                          mov     BYTE [%2],      1
   116                                  %%inicio:
   117                                          cmp     BYTE [%1],      %3          
   118                                          jg      %%aca
   119                                  
   120                                          cmp     BYTE [%2],      %4        
   121                                          jg      %%cambioFila
   122                                  
   123                                  
   124                                          calcular_direccion_de_una_posicion  %2,%1,%4
   125                                          movzx   rdx, BYTE [%5 + rax]   
   126                                  
   127                                  
   128                                          calcular_direccion_de_una_posicion %1,%2, %4
   129                                          mov     [%6 + rax], rdx  
   130                                  
   131                                          inc     BYTE [%2]                   
   132                                          jmp     %%inicio                     
   133                                  
   134                                  %%cambioFila:
   135                                          inc     BYTE [%1]                  
   136                                          mov     BYTE [%2],    1            
   137                                          jmp     %%inicio
   138                                  %%aca:
   139                                  %endmacro
