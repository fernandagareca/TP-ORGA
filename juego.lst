   698                                  ; Rotar matriz hacia la derecha:
   699                                  ; Props:
   700                                  ; %1: matriz
   701                                  ; %2: tablero_rotacion_derecha
   702                                  %macro rotar_derecha 2
   703                                          mov     BYTE [i], 0
   704                                          mov     BYTE [j], 0
   705                                  %%inicio:
   706                                          cmp     BYTE [i],  CANT_FIL          
   707                                          je      %%fin             
   708                                  
   709                                          cmp     BYTE [j],  CANT_COL        
   710                                          je      %%cambioFila    
   711                                  
   712                                          obtener_posicion_vector_matriz  j,i,CANT_COL
   713                                          movzx   rdx, BYTE [%1 + rax]   ; rdx = matriz[j][i]
   714                                  
   715                                          obtener_posicion_vector_matriz i,j, CANT_COL
   716                                          mov     [%2 + rax], rdx         ; matriz_inversa[i][j] = matriz[j][i] 
   717                                  
   718                                          inc     BYTE [j]                   
   719                                          jmp     %%inicio                     
   720                                  
   721                                  %%cambioFila:
   722                                          inc     BYTE [i]                  
   723                                          mov     BYTE [j],    0            
   724                                          jmp     %%inicio
   725                                  %%fin:
   726                                  %endmacro
